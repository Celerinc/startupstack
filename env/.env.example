# =========================
# Core Configuration
# =========================
DOMAIN=example.com
EMAIL=admin@${DOMAIN}

# =========================
# Versions
# =========================
PLANE_VERSION=v1.2.0
N8N_VERSION=2.2.4

# =========================
# MinIO
# =========================
MINIO_ENDPOINT_URL=https://s3.${DOMAIN}

# =========================
# Headscale
# =========================
HEADSCALE_BASE_URL=https://hs.${DOMAIN}
HEADPLANE_BASE_URL=https://hs.${DOMAIN}/ui
HEADSCALE_API_KEY=changeme

# =========================
# Plane - Public URLs
# =========================
PLANE_WEB_URL=https://plane.${DOMAIN}
PLANE_APP_BASE_URL=https://plane.${DOMAIN}/
PLANE_ADMIN_BASE_URL=https://plane.${DOMAIN}/god-mode
PLANE_SPACE_BASE_URL=https://plane.${DOMAIN}/spaces/


# =========================
# Plane - Frontend Public Env
# (must match URLs above)
# =========================
NEXT_PUBLIC_WEB_URL=https://plane.${DOMAIN}
NEXT_PUBLIC_APP_BASE_URL=https://plane.${DOMAIN}
NEXT_PUBLIC_ADMIN_BASE_URL=https://plane.${DOMAIN}/god-mode
NEXT_PUBLIC_SPACE_BASE_URL=https://plane.${DOMAIN}/spaces


# =========================
# Plane - Proxy (plane-proxy only)
# =========================
PLANE_PROXY_LISTEN_HTTP_PORT=80
PLANE_PROXY_LISTEN_HTTPS_PORT=443
PLANE_PROXY_API_BASE_URL=https://plane.${DOMAIN}/api
PLANE_PROXY_ADMIN_BASE_URL=https://plane.${DOMAIN}/god-mode
PLANE_PROXY_SPACE_BASE_URL=https://plane.${DOMAIN}/spaces
PLANE_PROXY_CORS_ALLOWED_ORIGINS=https://plane.${DOMAIN}


# =========================
# Plane - Backend / Runtime
# =========================
PLANE_SECRET_KEY=change-me
PLANE_DB_PASSWORD=change-me
PLANE_BUCKET=plane
PLANE_GUNICORN_WORKERS=2

PLANE_ENABLE_SIGNUP=true
PLANE_ENABLE_EMAIL_PASSWORD=true
PLANE_DISABLE_WORKSPACE_CREATION=false


# =========================
# MinIO (S3-compatible)
# =========================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me


# =========================
# n8n
# =========================
N8N_HOST=n8n.${DOMAIN}
N8N_PROTOCOL=https
N8N_WEBHOOK_URL=https://n8n.${DOMAIN}/
N8N_ENCRYPTION_KEY=change-me


# =========================
# NanoBot (Slack channel, OpenAI Codex-first defaults)
# Used by docs/scripts when generating first NanoBot config.
# =========================
NANOBOT_PROVIDER=openai
NANOBOT_MODEL=openai/gpt-5.3-codex
NANOBOT_REASONING_EFFORT=low
NANOBOT_MAX_TOKENS=16384
NANOBOT_CONTEXT_WINDOW_TOKENS=128000
NANOBOT_TEMPERATURE=0.1
NANOBOT_OPENAI_API_KEY=change-me
NANOBOT_SLACK_BOT_TOKEN=xoxb-change-me
NANOBOT_SLACK_APP_TOKEN=xapp-change-me
NANOBOT_SLACK_ALLOW_FROM=
NANOBOT_SEND_PROGRESS=false
NANOBOT_SEND_TOOL_HINTS=false
NANOBOT_GITHUB_TOKEN=
NANOBOT_GITHUB_OWNER=celerinc
NANOBOT_GITHUB_DEFAULT_VISIBILITY=private
NANOBOT_STATE_DIR=/home/youruser/agents/.alex
NANOBOT_OAUTH_DIR=/home/youruser/agents/.oauth


# =========================
# ClickHouse (optional)
# =========================
# CLICKHOUSE_DB=default
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=change-me
