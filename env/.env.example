# =========================
# Versions
# =========================
PLANE_VERSION=v1.2.0
N8N_VERSION=2.2.4

# =========================
# MinIO
# =========================
MINIO_ENDPOINT_URL=https://s3.example.com

# =========================
# Plane – Public URLs
# =========================
PLANE_WEB_URL=https://plane.example.com
PLANE_APP_BASE_URL=https://plane.example.com/
PLANE_ADMIN_BASE_URL=https://plane.example.com/god-mode
PLANE_SPACE_BASE_URL=https://plane.example.com/spaces/


# =========================
# Plane – Frontend Public Env
# (must match URLs above)
# =========================
NEXT_PUBLIC_WEB_URL=https://plane.example.com
NEXT_PUBLIC_APP_BASE_URL=https://plane.example.com
NEXT_PUBLIC_ADMIN_BASE_URL=https://plane.example.com/god-mode
NEXT_PUBLIC_SPACE_BASE_URL=https://plane.example.com/spaces


# =========================
# Plane – Proxy (plane-proxy only)
# =========================
PLANE_PROXY_LISTEN_HTTP_PORT=80
PLANE_PROXY_LISTEN_HTTPS_PORT=443
PLANE_PROXY_API_BASE_URL=https://plane.example.com/api
PLANE_PROXY_ADMIN_BASE_URL=https://plane.example.com/god-mode
PLANE_PROXY_SPACE_BASE_URL=https://plane.example.com/spaces
PLANE_PROXY_CORS_ALLOWED_ORIGINS=https://plane.example.com


# =========================
# Plane – Backend / Runtime
# =========================
PLANE_SECRET_KEY=change-me
PLANE_DB_PASSWORD=change-me
PLANE_BUCKET=plane
PLANE_GUNICORN_WORKERS=2

PLANE_ENABLE_SIGNUP=true
PLANE_ENABLE_EMAIL_PASSWORD=true
PLANE_DISABLE_WORKSPACE_CREATION=false


# =========================
# MinIO (S3-compatible)
# =========================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me


# =========================
# n8n
# =========================
N8N_HOST=n8n.example.com
N8N_PROTOCOL=https
N8N_WEBHOOK_URL=https://n8n.example.com/
N8N_ENCRYPTION_KEY=change-me-32-chars-min


# =========================
# Rocket.Chat
# =========================
ROCKETCHAT_ROOT_URL=https://chat.example.com


# =========================
# ClickHouse (optional)
# =========================
# CLICKHOUSE_DB=default
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=change-me