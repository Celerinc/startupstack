# Versions
PLANE_VERSION=v1.2.0
N8N_VERSION=2.2.4

# Plane / Postgres
PLANE_DB_PASSWORD=change-me
PLANE_BUCKET=plane

# MinIO (S3-compatible storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me

# Public URLs
PLANE_WEB_URL=https://plane.example.com
PLANE_SECRET_KEY=your-plane-secret-key

# n8n
N8N_HOST=n8n.example.com
N8N_PROTOCOL=https
N8N_WEBHOOK_URL=https://n8n.example.com/
N8N_ENCRYPTION_KEY=change-me-32-chars-min

# Rocket.Chat
ROCKETCHAT_ROOT_URL=https://chat.example.com

# ClickHouse (later)
# CLICKHOUSE_DB=default
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=change-me

ENABLE_EMAIL_PASSWORD_AUTH=true
