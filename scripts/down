#!/usr/bin/env bash
set -euo pipefail

MODE="${1:-local}"
PROFILE="${2:-}" # optional: analytics

BASE="-f compose/compose.yml"
LOCAL="-f compose/compose.local.yml"
PROD="-f compose/compose.prod.yml"

PROFILE_FLAG=""
if [ "${PROFILE}" = "analytics" ]; then
  PROFILE_FLAG="--profile analytics"
fi

if [ "$MODE" = "local" ]; then
  docker compose $BASE $LOCAL $PROFILE_FLAG down
elif [ "$MODE" = "prod" ]; then
  docker compose $BASE $PROD $PROFILE_FLAG down
else
  echo "Usage: ./scripts/down [local|prod] [analytics]"
  exit 1
fi