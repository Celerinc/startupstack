#!/usr/bin/env bash
set -euo pipefail

MODE="${1:-local}"          # local | prod
shift || true
PROFILES=("$@")             # optional: ai analytics ai-cli

BASE_ARGS=(-f compose/compose.yml)
LOCAL_ARGS=(-f compose/compose.local.yml)
PROD_ARGS=(-f compose/compose.prod.yml)

PROFILE_ARGS=()
for profile in "${PROFILES[@]}"; do
  case "$profile" in
    "" )
      ;;
    ai|ai-cli|analytics)
      PROFILE_ARGS+=(--profile "$profile")
      ;;
    *)
      echo "❌ Invalid profile: $profile"
      echo "Usage: ./scripts/down [local|prod] [ai] [ai-cli] [analytics]"
      exit 1
      ;;
  esac
done

echo "⏹️  Stopping StartupStack"
if [ "${#PROFILES[@]}" -gt 0 ]; then
  echo "   Mode: $MODE (profiles: ${PROFILES[*]})"
else
  echo "   Mode: $MODE"
fi

if [ "$MODE" = "local" ]; then
  docker compose "${BASE_ARGS[@]}" "${LOCAL_ARGS[@]}" "${PROFILE_ARGS[@]}" down
elif [ "$MODE" = "prod" ]; then
  echo "⚠️  PROD shutdown"
  docker compose "${BASE_ARGS[@]}" "${PROD_ARGS[@]}" "${PROFILE_ARGS[@]}" down
else
  echo "❌ Invalid mode: $MODE"
  echo "Usage: ./scripts/down [local|prod] [ai] [ai-cli] [analytics]"
  exit 1
fi

echo "✅ StartupStack stopped"
