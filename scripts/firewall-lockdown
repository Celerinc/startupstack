#!/usr/bin/env bash
set -euo pipefail

echo "▶️ Resetting Docker firewall hook and disabling IPv6"

# Must be root
if [ "${EUID:-$(id -u)}" -ne 0 ]; then
  echo "ERROR: run as root: sudo $0"
  exit 1
fi

# Ensure DOCKER-USER exists, then flush and make it a no-op (RETURN)
iptables -N DOCKER-USER 2>/dev/null || true
iptables -F DOCKER-USER || true
iptables -C DOCKER-USER -j RETURN 2>/dev/null || iptables -A DOCKER-USER -j RETURN

echo "✅ DOCKER-USER reset to simple RETURN"
iptables -nvL DOCKER-USER --line-numbers || true

# Disable IPv6 (host-level)
sysctl -w net.ipv6.conf.all.disable_ipv6=1 >/dev/null
sysctl -w net.ipv6.conf.default.disable_ipv6=1 >/dev/null

echo "🔒 IPv6 disabled"
echo "🏁 Firewall lockdown complete (Docker hook is now clean, logic handled by UFW + Tailscale DNS)"