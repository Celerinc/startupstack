#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

echo "=== Docker containers ==="
docker ps --format 'table {{.Names}}\t{{.Image}}\t{{.Status}}'
echo

echo "=== Docker networks ==="
docker network ls
docker network inspect startupstack_internal --format '{{json .IPAM.Config}}'
docker network inspect startupstack_edge --format '{{json .IPAM.Config}}' || true
echo

echo "=== Caddy / Plane / Headscale IPs ==="
docker inspect -f '{{ .Name }} => {{range.NetworkSettings.Networks}}{{.NetworkID}} {{.IPAddress}}{{end}}' \
  startupstack-caddy-1 \
  startupstack-plane-proxy-1 \
  startupstack-headscale-1 2>/dev/null || true
echo

echo "=== Host interfaces ==="
ip -o addr show
echo

echo "=== Host routes ==="
ip route
echo

echo "=== Tailscale on VPS ==="
tailscale status || true
tailscale ip -4 || true
echo

echo "=== UFW status ==="
sudo ufw status verbose || true
echo

echo "=== iptables DOCKER-USER ==="
sudo iptables -vnL DOCKER-USER --line-numbers || true
echo


# Source env vars to get DOMAIN
if [ -f env/.env.prod ]; then
  export $(grep -v '^#' env/.env.prod | xargs)
else
  export DOMAIN="example.com"
fi

echo "=== plane.${DOMAIN} from VPS ==="
dig +short plane.${DOMAIN} @100.100.100.100 || true
curl -vk https://plane.${DOMAIN}/vpn-test || true
echo

echo "=== Caddy plane-access log (last 20) ==="
docker exec startupstack-caddy-1 sh -c 'tail -n 20 /var/log/plane-access.log' || true
echo