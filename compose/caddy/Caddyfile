  email {$EMAIL:admin@example.com}
}

# Client (100.64.0.4)
#  ↓
# Tailscale tunnel inside host
#  ↓
# Host forwards via NAT
#  ↓
# Docker bridge (172.18.0.5)
#  ↓
# Caddy sees remote_ip=172.18.0.5
#  ↓
# plane, n8n

# When Docker creates a default bridge network,
# it allocates a private container subnet
(vpn_only) {
  @notvpn not remote_ip 172.16.0.0/12
  respond @notvpn 403
}

# -------------------------
# Headscale
# -------------------------
hs.{$DOMAIN} {
  # --- Headplane UI (VPN ONLY) ---
  @ui path /ui/*
  handle @ui {
    # No IP check here. Firewall already protects tailscale-only access
    reverse_proxy headplane:3000
  }

  # --- Headscale control plane (PUBLIC) ---
  handle {
    reverse_proxy headscale:8080 {
      header_up X-Forwarded-Proto https
      header_up X-Forwarded-Host {host}
    }
  }
}

# -------------------------
# Plane (ONLY via plane-proxy)
# -------------------------
plane.{$DOMAIN} {
  import vpn_only

  log {
    output file /var/log/plane-access.log
    format json
  }

  @godmode_noslash path /god-mode
  redir @godmode_noslash /god-mode/ 308

  @spaces_noslash path /spaces
  redir @spaces_noslash /spaces/ 308

  reverse_proxy plane-proxy:80
}

# -------------------------
# MinIO
# -------------------------
s3.{$DOMAIN} {
  import vpn_only
  reverse_proxy plane-minio:9000
}

# -------------------------
# n8n
# -------------------------
n8n.{$DOMAIN} {
  import vpn_only
  reverse_proxy n8n:5678
}

