# -------------------------
# Plane
# -------------------------
plane.celerinc.cloud {

  # Backend routes (must go to plane-api)
  handle_path /api/* {
    reverse_proxy plane-api:8000
  }

  handle_path /auth/* {
    reverse_proxy plane-api:8000
  }

  handle_path /graphql/* {
    reverse_proxy plane-api:8000
  }

  handle_path /admin/* {
    reverse_proxy plane-api:8000
  }

  # Frontend (everything else)
  handle {
    reverse_proxy plane-web:3000
  }
}

# -------------------------
# n8n
# -------------------------
n8n.celerinc.cloud {
  reverse_proxy n8n:5678
}

# -------------------------
# Rocket.Chat
# -------------------------
chat.celerinc.cloud {
  reverse_proxy rocketchat:3000
}

