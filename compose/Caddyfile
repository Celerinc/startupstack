{
  email contact@celerinc.com
}

# Default: protect everything on this server
(auth) {
  basic_auth {
    {$CADDY_BASIC_AUTH_USER} {$CADDY_BASIC_AUTH_HASH}
  }
}

# -------------------------
# Plane
# -------------------------
plane.celerinc.cloud {
  import auth
  reverse_proxy plane-web:3000
}

# -------------------------
# n8n
# -------------------------
n8n.celerinc.cloud {
  import auth
  reverse_proxy n8n:5678
}

# -------------------------
# Rocket.Chat
# -------------------------
chat.celerinc.cloud {
  import auth
  reverse_proxy rocketchat:3000
}

