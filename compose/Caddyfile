# -------------------------
# Plane
# -------------------------
plane.celerinc.cloud {
  # API / auth / graphql must go to backend
  handle /api/* {
    reverse_proxy plane-api:8000
  }
  handle /auth/* {
    reverse_proxy plane-api:8000
  }
  handle /graphql/* {
    reverse_proxy plane-api:8000
  }
  handle /admin/* {
    reverse_proxy plane-api:8000
  }

  # Everything else -> frontend
  handle {
    reverse_proxy plane-web:3000
  }
}

# -------------------------
# n8n
# -------------------------
n8n.celerinc.cloud {
  reverse_proxy n8n:5678
}

# -------------------------
# Rocket.Chat
# -------------------------
chat.celerinc.cloud {
  reverse_proxy rocketchat:3000
}

